{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/renderer/src/*"
      ],
      "@shared/*": [
        "src/shared/*"
      ],
      "@rt/core": [
        "../../packages/core/src/index.ts"
      ],
      "@rt/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@rt/ui/styles": [
        "../../packages/ui/src/styles.css"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "electron.vite.config.ts"
  ]
}
