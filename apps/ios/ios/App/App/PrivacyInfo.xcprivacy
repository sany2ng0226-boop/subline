<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Optional RayNeo CoreBluetooth traffic stays between this phone and glasses.
         Diagnostic logs (UUIDs and payload hex) use bounded process memory
         and NSLog system logging; the plugin does not upload them.
         Bluetooth permission text is declared in Info.plist. -->
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>
    <!-- apps/ios/src/bridge.ts routes cloud translation through CloudTranslator to
         the user-configured endpoint, not a developer collection service.
         Audio is processed on-device by native-plugin/ios/RealtimeAsrPlugin.swift. -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <!-- apps/ios/package.json includes @capacitor/preferences;
                 apps/ios/src/bridge.ts uses Preferences.get/set for this app's
                 settings and archives stored in UserDefaults. -->
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
        <dict>
            <!-- apps/ios/native-plugin/ios/RealtimeAsrPlugin.swift:
                 listModels and fileIsIntact call FileManager.attributesOfItem
                 for model files in the app's Application Support directory.
                 This required-reason API returns file metadata; callers use .size. -->
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>C617.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
