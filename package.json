{
  "name": "realtime-translator-monorepo",
  "version": "0.2.0-beta.4",
  "description": "Local, real-time speech transcription & translation for macOS, iOS, and the browser (monorepo)",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "version:check": "node scripts/sync-version.mjs --check",
    "version:sync": "node scripts/sync-version.mjs --write",
    "postinstall": "node node_modules/electron/install.js",
    "dev": "pnpm --filter @rt/macos dev",
    "build": "pnpm --filter @rt/macos build",
    "type-check": "pnpm --filter @rt/macos type-check",
    "dist": "pnpm --filter @rt/macos dist",
    "dist:dir": "pnpm --filter @rt/macos dist:dir",
    "check": "pnpm --filter @rt/core test && pnpm --filter @rt/macos test && pnpm --filter @rt/web test && pnpm test:ui && pnpm --filter @rt/macos test-eval-corpus && pnpm --filter @rt/macos type-check && pnpm --filter @rt/web type-check && pnpm --filter @rt/ios type-check",
    "dist:windows": "pnpm --filter @rt/macos dist:windows",
    "test:ui": "pnpm --filter @rt/core exec vitest run --root ../.. packages/ui/src"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "onnxruntime-node",
      "sharp",
      "node-llama-cpp"
    ],
    "overrides": {
      "string-width": "^4.2.3",
      "cmake-js>tar": "^7.5.21",
      "source-map-js@^1.2.1": "^1.2.2"
    }
  }
}
