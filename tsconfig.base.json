{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@rt/core": [
        "./packages/core/src/index.ts"
      ],
      "@rt/ui": [
        "./packages/ui/src/index.ts"
      ],
      "@rt/ui/styles": [
        "./packages/ui/src/styles.css"
      ]
    }
  }
}
